{
  "name": "qc-checklist-app",
  "version": "1.0.0",
  "description": "Offline-first Quality Control Checklist for construction sites",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "^52.0.0",
    "expo-camera": "^15.0.0",
    "expo-image-picker": "^15.0.0",
    "expo-router": "^4.0.0",
    "expo-sqlite": "^14.0.0",
    "expo-status-bar": "^2.0.0",
    "react": "^18.2.0",
    "react-native": "^0.76.0",
    "react-native-gesture-handler": "^2.20.0",
    "react-native-reanimated": "^3.14.0",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "^4.0.0",
    "nativewind": "^2.0.11",
    "tailwindcss": "^3.4.0",
    "uuid": "^9.0.0",
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "@react-native-community/eslint-config": "^3.2.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.73.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "typescript": "^5.3.0",
    "jest": "^29.0.0",
    "@testing-library/react-native": "^12.0.0"
  },
  "expo": {
    "plugins": [
      [
        "expo-router",
        {
          "origin": false,
          "asyncRoutes": true
        }
      ]
    ]
  }
}
