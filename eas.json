{
  "cli": {
    "version": ">= 3.0.0"
  },
  "build": {
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://barnard-checklist.onrender.com"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "env": {
        "EXPO_PUBLIC_SEED_DATA": "true",
        "EXPO_PUBLIC_API_URL": "https://barnard-checklist.onrender.com"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "development": {
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3000"
      },
      "android": {
        "buildType": "apk",
        "distribution": "internal"
      },
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {}
  }
}
