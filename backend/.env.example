# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/qc_checklist_db

# Server Configuration
PORT=3000
NODE_ENV=development

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# AWS S3 (for photo storage). When these are unset the backend stores photos
# under ./uploads instead, so local development needs no cloud setup.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=qc-checklist-photos
AWS_REGION=us-east-1
# Optional CDN/base URL for serving uploaded objects.
AWS_S3_PUBLIC_BASE_URL=
# Base URL used to serve photos in local-disk fallback mode.
LOCAL_UPLOAD_BASE_URL=/uploads

# API Configuration
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000,http://localhost:19000

# Expo Push (for cross-device management alerts). Only required if your Expo
# project enforces push security; otherwise leave blank — the backend sends to
# Expo's push service without it.
EXPO_ACCESS_TOKEN=
